---
import { shippedProducts } from '../data/content';
---

<section class="release-section dark-section">
	<header class="section-heading reveal">
		<p class="micro">03 / Shipped products</p>
		<h2>Three more apps.<br />Released to stores.</h2>
	</header>

	<ol class="release-list">
		{shippedProducts.map((project) => (
			<li class="release reveal">
				<div class="release-title">
					<span class="release-no">{project.index}</span>
					<h3>{project.name}</h3>
				</div>
				<div class="release-meta">
					<p>{project.platform}</p>
					<p>{project.date}</p>
				</div>
				<p class="release-highlight">{project.highlight}</p>
				<div class="release-link" aria-label="Store availability">
					{'playUrl' in project && project.playUrl && (
						<a href={project.playUrl}>Google Play</a>
					)}
					{'storeUrl' in project && project.storeUrl && (
						<a href={project.storeUrl}>App Store</a>
					)}
				</div>
			</li>
		))}
	</ol>
</section>

<style>
	.release-section {
		padding: var(--section-pad) var(--page-pad);
		user-select: none;
	}

	.release-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid #424242;
		list-style: none;
	}

	.release {
		display: grid;
		grid-template-columns: minmax(14rem, 1fr) minmax(8rem, 0.45fr) minmax(17rem, 1.15fr) auto;
		gap: 1.25rem;
		align-items: center;
		min-height: 6.4rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid #424242;
		transition: padding 0.4s var(--ease);
	}

	.release:hover {
		padding-right: 0.75rem;
		padding-left: 0.75rem;
	}

	.release-title {
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}

	.release-no,
	.release-meta,
	.release-link {
		font-family: var(--mono);
		font-size: 0.6rem;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.release-title h3 {
		margin: 0;
		font-size: clamp(1.35rem, 2.2vw, 2.15rem);
		font-weight: 500;
		letter-spacing: -0.04em;
	}

	.release-meta p,
	.release-highlight {
		margin: 0;
	}

	.release-meta p + p {
		margin-top: 0.25rem;
		color: #aaa;
	}

	.release-highlight {
		font-size: 0.85rem;
		line-height: 1.45;
	}

	.release-link {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.65rem;
		justify-content: flex-end;
		text-align: right;
	}

	.release-link a {
		display: inline-block;
		padding: 0.4rem 0.6rem;
		border: 1px solid #555;
		color: inherit;
		text-decoration: none;
		letter-spacing: 0.04em;
		transition:
			border-color 0.25s var(--ease),
			background 0.25s var(--ease);
	}

	.release-link a:hover {
		border-color: currentColor;
		background: rgb(244 244 240 / 0.08);
	}

	@media (max-width: 68rem) {
		.release {
			grid-template-columns: minmax(0, 1fr) minmax(7.5rem, auto);
			gap: 0.85rem 1.25rem;
			align-items: start;
		}

		.release-title {
			grid-column: 1;
			grid-row: 1;
		}

		.release-meta {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
			text-align: right;
		}

		.release-highlight {
			grid-column: 1;
			grid-row: 2;
		}

		.release-link {
			grid-column: 2;
			grid-row: 2;
			align-self: end;
			justify-content: flex-end;
			padding-left: 0;
		}
	}

	@media (max-width: 47.99rem) {
		.release {
			grid-template-columns: 1fr auto;
			gap: 0.8rem;
		}

		.release-title {
			grid-column: 1;
			grid-row: 1;
		}

		.release-meta {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
			text-align: right;
		}

		.release-highlight {
			grid-column: 1 / -1;
			grid-row: 2;
			padding-left: 2.25rem;
		}

		.release-link {
			grid-column: 1 / -1;
			grid-row: 3;
			justify-content: flex-start;
			padding-left: 2.25rem;
			text-align: left;
		}
	}
</style>
