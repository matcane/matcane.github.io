---
import { flagship } from '../data/content';
---

<section class="featured">
	<div class="section-index reveal">
		<span>02</span>
		<p>Commercial product<br />in production</p>
	</div>

	<div class="featured-main">
		<header class="featured-head reveal">
			<div>
				<p class="micro">{flagship.status} / {flagship.platforms}</p>
				<h2>{flagship.name}</h2>
			</div>
			<p class="project-number">{flagship.index}/05</p>
		</header>

		<p class="project-summary reveal">{flagship.summary}</p>

		<div class="featured-grid">
			<div class="outcomes reveal" aria-label="T-Up production results">
				{flagship.results.map((result) => (
					<div>
						<strong>{result.value}</strong>
						<span>{result.label}</span>
					</div>
				))}
			</div>

			<div class="contribution reveal">
				<p class="micro">My contribution</p>
				<ul class="contribution-list">
					{flagship.contribution.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<ul class="stack-row" aria-label="T-Up technology stack">
					{flagship.stack.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<div class="project-links" aria-label="T-Up store availability">
					<a href={flagship.playUrl}>Google Play</a>
					<a href={flagship.storeUrl}>App Store</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.featured {
		display: grid;
		grid-template-columns: minmax(6.5rem, 0.18fr) 1fr;
		gap: clamp(2rem, 4vw, 4rem);
		padding: var(--section-pad) var(--page-pad);
		user-select: none;
	}

	.featured-main {
		min-width: 0;
	}

	.featured-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
		border-bottom: 1px solid var(--ink);
	}

	.featured-head h2 {
		margin: 0.35rem 0 0;
		font-size: clamp(4.25rem, 10vw, 8.5rem);
		font-weight: 600;
		line-height: 0.78;
		letter-spacing: -0.075em;
	}

	.project-number {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.65rem;
	}

	.project-summary {
		max-width: 51rem;
		margin: clamp(1.5rem, 3vw, 2.5rem) 0;
		font-size: clamp(1.05rem, 1.75vw, 1.4rem);
		line-height: 1.4;
		letter-spacing: -0.02em;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: minmax(20rem, 0.9fr) minmax(20rem, 1.1fr);
		gap: clamp(2rem, 5vw, 5rem);
		padding-top: clamp(1.5rem, 3vw, 2.5rem);
		border-top: 1px solid var(--ink);
	}

	.outcomes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.outcomes > div {
		min-width: 0;
	}

	.outcomes > div + div {
		padding-left: clamp(1rem, 2vw, 2rem);
		border-left: 1px solid var(--line);
	}

	.outcomes strong,
	.outcomes span {
		display: block;
	}

	.outcomes strong {
		font-size: clamp(2.7rem, 5vw, 5rem);
		font-weight: 350;
		line-height: 0.9;
		letter-spacing: -0.07em;
	}

	.outcomes span {
		max-width: 11rem;
		margin-top: 0.75rem;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.61rem;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.contribution-list {
		margin: 0.85rem 0 1.5rem;
		padding: 0;
		border-top: 1px solid var(--line);
		list-style: none;
	}

	.contribution-list li {
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.86rem;
		line-height: 1.4;
	}

	.contribution-list li::before {
		margin-right: 0.65rem;
		color: var(--muted);
		content: '-';
	}

	.stack-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack-row li {
		padding: 0.4rem 0.55rem;
		border: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 0.57rem;
		text-transform: uppercase;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.project-links a,
	.project-links span {
		padding: 0.7rem 0.85rem;
		border: 1px solid currentColor;
		color: inherit;
		font-family: var(--mono);
		font-size: 0.6rem;
		text-decoration: none;
		text-transform: uppercase;
	}

	@media (max-width: 68rem) {
		.featured-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 47.99rem) {
		.featured {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.featured-head h2 {
			font-size: 4.5rem;
		}

		.outcomes strong {
			font-size: clamp(2.35rem, 11vw, 4rem);
		}
	}

	@media (max-width: 31rem) {
		.outcomes {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.outcomes > div + div {
			padding: 1.25rem 0 0;
			border-top: 1px solid var(--line);
			border-left: 0;
		}
	}
</style>
